<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SharpClaw.ModuleSDK.Testing</PackageId>
    <Version>0.5.0-beta.12</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-beta.12</InformationalVersion>
    <Authors>mkn8rn</Authors>
    <Description>Runs SharpClaw module action and event graphs against the production Core dispatcher in isolated tests.</Description>
    <PackageTags>sharpclaw;modules;sdk;testing;conformance</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SharpClaw-NET/SharpClaw.ModuleSDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/SharpClaw-NET/SharpClaw.ModuleSDK</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpClaw.Contracts" Version="[0.5.0-beta.36]" />
    <PackageReference Include="SharpClaw.Core" Version="[0.5.0-beta.31]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpClaw.ModuleSDK\SharpClaw.ModuleSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
